{
  "name": "mora",
  "scopeName": "source.mora",
  "fileTypes": ["mora"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#builtin-types" },
    { "include": "#builtin-modules" },
    { "include": "#task-call" },
    { "include": "#method-call" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.mora",
          "match": "--.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.mora",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.mora",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.mora",
          "match": "-?\\d[\\d_]*(\\.[\\d_]+)?([eE][+-]?[\\d_]+)?(f16|bf16|fp8_e4m3|fp8_e5m2|fp8|f32|f64|f|i4|i8|i16|i32|i64|i|u8|u16|u32|u64|u)?"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.mora",
          "match": "\\b(let|assign|task|fn|if|then|else|end|for|in|while|loop|break|continue|do|return|parallel|worker|transaction|compensation|commit|rollback|match|with|when|import|export|struct|enum|trait|impl|dyn|as|type|macro|effect|perform|handle|spawn|select|case|timeout|default|no_grad|grad|value_and_grad|jvp|trace_dag|quote|eval|read|into|and|or|not|true|false|nil|Self)\\b"
        }
      ]
    },
    "builtin-types": {
      "patterns": [
        {
          "name": "entity.name.type.mora",
          "match": "\\b(string|char|int|float|number|bool|nil|f16|bf16|fp8|fp8_e4m3|fp8_e5m2|f32|f64|i4|i8|i16|i32|i64|u8|u16|u32|u64|list|dict|tensor|Tensor|compute_dag|kv_allocator|memory_pool|task|closure|result|any|channel|task_handle|context|tcp_listener|tcp_stream|continuation|external|atom)\\b"
        }
      ]
    },
    "builtin-modules": {
      "patterns": [
        {
          "name": "support.module.mora",
          "match": "\\b(json|file|exec|math|stats|linalg|random|Tensor)\\b"
        }
      ]
    },
    "task-call": {
      "name": "entity.name.function.mora",
      "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*\\("
    },
    "method-call": {
      "name": "support.function.mora",
      "match": "\\.([a-z_][a-zA-Z0-9_]*)\\b"
    },
    "identifiers": {
      "name": "variable.other.mora",
      "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
    }
  }
}
