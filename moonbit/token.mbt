priv enum Tok {
  Let(Span)
  Task(Span)
  If(Span)
  Then(Span)
  End(Span)
  Return(Span)
  True(Span)
  False(Span)
  Nil(Span)
  For(Span)
  In(Span)
  Match(Span)
  Fn(Span)
  Break(Span)
  Continue(Span)
  With(Span)
  As(Span)
  TypeKw(Span)
  EnumKw(Span)
  StructKw(Span)
  Import(Span)
  Macro(Span)
  Loop(Span)
  Dyn(Span)
  Ident(String, Span)
  Str(String, Span)
  Int(Int64, Span)
  Float(Double, Span)
  Char(Char, Span)
  Plus(Span)
  Minus(Span)
  Star(Span)
  StarStar(Span)
  Slash(Span)
  Percent(Span)
  At(Span)
  Assign(Span)
  Eq(Span)
  NotEq(Span)
  Gt(Span)
  Lt(Span)
  Ge(Span)
  Le(Span)
  Pipe(Span)
  Bang(Span)
  Arrow(Span)
  FatArrow(Span)
  LParen(Span)
  RParen(Span)
  LBrack(Span)
  RBrack(Span)
  LBrace(Span)
  RBrace(Span)
  Dot(Span)
  Comma(Span)
  Colon(Span)
  ColonColon(Span)
  Newline(Span)
  Eof(Span)
}

fn Tok::span(self : Tok) -> Span {
  match self {
    Let(s) | Task(s) | If(s) | Then(s) | End(s) | Return(s) | True(s) | False(s) | Nil(s) | For(s) | In(s) | Match(s) | Fn(s) | Break(s) | Continue(s) | With(s) | As(s) | TypeKw(s) | EnumKw(s) | StructKw(s) | Import(s) | Macro(s) | Loop(s) | Dyn(s) | Plus(s) | Minus(s) | Star(s) | StarStar(s) | Slash(s) | Percent(s) | At(s) | Assign(s) | Eq(s) | NotEq(s) | Gt(s) | Lt(s) | Ge(s) | Le(s) | Pipe(s) | Bang(s) | Arrow(s) | FatArrow(s) | LParen(s) | RParen(s) | LBrack(s) | RBrack(s) | LBrace(s) | RBrace(s) | Dot(s) | Comma(s) | Colon(s) | ColonColon(s) | Newline(s) | Eof(s) => s
    Ident(_, s) | Str(_, s) | Int(_, s) | Float(_, s) | Char(_, s) => s
  }
}

/// Keyword or identifier text, for dict keys and method names.
fn Tok::word(self : Tok) -> String? {
  match self {
    Ident(name, _) => Some(name)
    Let(_) => Some("let")
    Task(_) => Some("task")
    If(_) => Some("if")
    Then(_) => Some("then")
    End(_) => Some("end")
    Return(_) => Some("return")
    True(_) => Some("true")
    False(_) => Some("false")
    Nil(_) => Some("nil")
    For(_) => Some("for")
    In(_) => Some("in")
    Match(_) => Some("match")
    Fn(_) => Some("fn")
    Break(_) => Some("break")
    Continue(_) => Some("continue")
    With(_) => Some("with")
    As(_) => Some("as")
    TypeKw(_) => Some("type")
    EnumKw(_) => Some("enum")
    StructKw(_) => Some("struct")
    Import(_) => Some("import")
    Macro(_) => Some("macro")
    Loop(_) => Some("loop")
    Dyn(_) => Some("dyn")
    _ => None
  }
}
