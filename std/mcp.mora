-- Pure-Mora Model Context Protocol (MCP) Standard Library (`std/mcp`)
-- Implements JSON-RPC 2.0 MCP server (initialize, ping, notifications/initialized,
-- tools/list, tools/call with JSON Schema validation, resources/list, resources/read,
-- prompts/list, prompts/get) over HTTP+SSE (`std/net/http`) and Stdio NDJSON transports,
-- plus automatic `Struct::schema()` -> JSON Schema binding.

import "std/net/http"

export struct McpTool
  name: string
  description: string
  schema: dict<string, any>
  handler: any
end

export struct McpResource
  uri: string
  name: string
  description: string
  mime_type: string = "text/plain"
  reader: any
end

export struct McpPrompt
  name: string
  description: string
  arguments: list<dict<string, any>>
  handler: any
end

export struct McpServer
  name: string = "mora-mcp"
  version: string = "0.1.0"
  tools: dict<string, McpTool>
  resources: dict<string, McpResource>
  prompts: dict<string, McpPrompt>
end

export task prompt_arg(name: string, description: string = "", required: bool = true): dict<string, any>
  let arg: dict<string, any> = {}
  assign arg = arg.set("name", name).set("description", description).set("required", required)
  return arg
end

export task server(name: string = "mora-mcp", version: string = "0.1.0"): McpServer
  let t: dict<string, McpTool> = {}
  let r: dict<string, McpResource> = {}
  let p: dict<string, McpPrompt> = {}
  return McpServer(name=name, version=version, tools=t, resources=r, prompts=p)
end

task slice_str(s: string, start: int, end_excl: int): string
  let out = ""
  let i = start
  let n = s.len()
  let lim = if end_excl < n then end_excl else n end
  while i < lim
    assign out = out + str(s[i])
    assign i = i + 1
  end
  return out
end

export task mora_type_to_json_schema(mora_ty: string): dict<string, any>
  let ty = mora_ty.trim().lower()
  let out: dict<string, any> = {}
  if ty == "int" or ty == "i64" or ty == "i32" or ty == "i16" or ty == "i8" or ty == "i4" or ty == "u64" or ty == "u32" or ty == "u16" or ty == "u8" then
    return out.set("type", "integer")
  end
  if ty == "float" or ty == "f64" or ty == "f32" or ty == "f16" or ty == "bf16" or ty == "fp8" or ty == "number" then
    return out.set("type", "number")
  end
  if ty == "string" or ty == "char" then
    return out.set("type", "string")
  end
  if ty == "bool" then
    return out.set("type", "boolean")
  end
  if ty.starts_with("list<") and ty.ends_with(">") then
    let inner = slice_str(ty, 5, ty.len() - 1)
    return out.set("type", "array").set("items", mora_type_to_json_schema(inner))
  end
  if ty == "list" then
    return out.set("type", "array")
  end
  if ty == "dict" or ty.starts_with("dict<") then
    return out.set("type", "object")
  end
  return out
end

-- Convert a nominal Mora struct's `MyStruct::schema()` metadata (including `@tag(json=..., desc=..., optional=...)`
-- and default field flags) into a standard MCP JSON Schema object.
export task schema_from_struct(struct_schema: dict<string, any>): dict<string, any>
  let sname = struct_schema.get("name")
  let fields = struct_schema.get("fields")
  let props: dict<string, any> = {}
  let req_fields: list<string> = []
  if fields != nil and type_of(fields) == "list" then
    let flist: any = fields
    for f in flist
      let fname = str(f.get("name"))
      let ftype = str(f.get("type"))
      let has_def = f.get("has_default") == true
      let tags = f.get("tags")
      let prop_name = fname
      let prop_schema = mora_type_to_json_schema(ftype)
      let tag_optional = false
      let tag_skip = false
      if tags != nil and type_of(tags) == "dict" then
        let json_alias = tags.get("json")
        if json_alias != nil and str(json_alias) != "" then
          let jraw = str(json_alias).trim()
          if jraw == "-" then
            assign tag_skip = true
          end
          if !tag_skip then
            let jparts = jraw.split(",")
            let jname = jparts.get(0).trim()
            if jname != "" then
              assign prop_name = jname
            end
            for jp in jparts.drop(1)
              if jp.trim() == "omitempty" then
                assign tag_optional = true
              end
            end
          end
        end
        let desc = tags.get("desc")
        let desc2 = tags.get("description")
        if desc != nil and str(desc) != "" then
          assign prop_schema = prop_schema.set("description", str(desc))
        end
        if (desc == nil or str(desc) == "") and desc2 != nil and str(desc2) != "" then
          assign prop_schema = prop_schema.set("description", str(desc2))
        end
        let opt_flag = tags.get("optional")
        if opt_flag != nil and str(opt_flag).lower() == "true" then
          assign tag_optional = true
        end
      end
      if !tag_skip then
        assign props = props.set(prop_name, prop_schema)
        if !has_def and !tag_optional then
          assign req_fields = req_fields.push(prop_name)
        end
      end
    end
  end
  let out: dict<string, any> = {}
  assign out = out.set("type", "object")
  if sname != nil and str(sname) != "" then
    assign out = out.set("title", str(sname))
  end
  assign out = out.set("properties", props).set("required", req_fields).set("additionalProperties", false)
  return out
end

task validate_json_value_type(val: any, expected_type: string): bool
  let actual = type_of(val)
  if expected_type == "integer" then
    return actual == "int"
  end
  if expected_type == "number" then
    return actual == "int" or actual == "float"
  end
  if expected_type == "string" then
    return actual == "string"
  end
  if expected_type == "boolean" then
    return actual == "bool"
  end
  if expected_type == "array" then
    return actual == "list"
  end
  if expected_type == "object" then
    return actual == "dict"
  end
  return true
end

task validate_tool_args(schema: dict<string, any>, args: dict<string, any>): string
  let req = schema.get("required")
  if req != nil and type_of(req) == "list" then
    let rlist: any = req
    for rk in rlist
      let key = str(rk)
      if args.get(key) == nil then
        return "missing required argument '" + key + "'"
      end
    end
  end
  let props = schema.get("properties")
  let disallow_extra = schema.get("additionalProperties") == false
  if props != nil and type_of(props) == "dict" then
    for ak in args.keys()
      let prop = props.get(ak)
      if prop == nil then
        if disallow_extra then
          return "unexpected argument '" + ak + "'"
        end
      else
        if type_of(prop) == "dict" then
          let expected = prop.get("type")
          if expected != nil then
            let aval = args.get(ak)
            if aval != nil and !validate_json_value_type(aval, str(expected)) then
              return "argument '" + ak + "' expected " + str(expected) + ", got " + type_of(aval)
            end
          end
        end
      end
    end
  end
  return ""
end

task rpc_ok(id: any, result: any): string
  let env_obj: dict<string, any> = {}
  assign env_obj = env_obj.set("jsonrpc", "2.0").set("id", id).set("result", result)
  return json.stringify(env_obj)
end

task rpc_err(id: any, code: int, message: string): string
  let err_obj: dict<string, any> = {}
  assign err_obj = err_obj.set("code", code).set("message", message)
  let env_obj: dict<string, any> = {}
  assign env_obj = env_obj.set("jsonrpc", "2.0").set("id", id).set("error", err_obj)
  return json.stringify(env_obj)
end

task tool_result_payload(text_out: string, is_error: bool): dict<string, any>
  let content_item: dict<string, any> = {"type": "text", "text": text_out}
  let call_out: dict<string, any> = {}
  assign call_out = call_out.set("content", [content_item]).set("isError", is_error)
  return call_out
end

task format_tool_value(val: any): dict<string, any>
  if type_of(val) == "result" then
    let as_res: result<any, any> = val
    if as_res.is_err() then
      return tool_result_payload(str(as_res.unwrap_err()), true)
    end
    return format_tool_value(as_res.unwrap())
  end
  if type_of(val) == "dict" then
    let d: dict<string, any> = val
    if type_of(d.get("content")) == "list" and type_of(d.get("isError")) == "bool" then
      return d
    end
  end
  let text_out = if type_of(val) == "string" then str(val) else json.stringify(val) end
  return tool_result_payload(text_out, false)
end

task decode_mcp_http_response(resp: HttpClientResponse): result<dict<string, any>, string>
  if resp.status == 0 then
    return Err("HTTP connection closed before receiving MCP response")
  end
  if resp.status == 204 then
    let empty_obj: dict<string, any> = {}
    return Ok(empty_obj)
  end
  if resp.status < 200 or resp.status >= 300 then
    let status_desc = "HTTP " + str(resp.status)
    if resp.status_text != "" then
      assign status_desc = status_desc + " " + resp.status_text
    end
    if resp.body != "" then
      assign status_desc = status_desc + ": " + resp.body
    end
    return Err(status_desc)
  end
  let parsed = resp.body.json()
  let perr = parsed.get("err")
  if perr != nil then
    return Err("invalid JSON in MCP response: " + str(perr))
  end
  let body_val = parsed.get("ok")
  if type_of(body_val) != "dict" then
    return Err("invalid MCP response: expected JSON object, got " + type_of(body_val))
  end
  let out_dict: dict<string, any> = body_val
  return Ok(out_dict)
end

export impl McpServer
  task tool(self, name: string, description: string, schema: dict<string, any>, handler: any): McpServer
    let t = McpTool(name=name, description=description, schema=schema, handler=handler)
    return McpServer(name=self.name, version=self.version, tools=self.tools.set(name, t), resources=self.resources, prompts=self.prompts)
  end

  task typed_tool(self, name: string, description: string, struct_schema: dict<string, any>, handler: any): McpServer
    let json_schema = schema_from_struct(struct_schema)
    return self.tool(name, description, json_schema, handler)
  end

  task resource(self, uri: string, name: string, description: string, mime_type: string, reader: any): McpServer
    let res = McpResource(uri=uri, name=name, description=description, mime_type=mime_type, reader=reader)
    return McpServer(name=self.name, version=self.version, tools=self.tools, resources=self.resources.set(uri, res), prompts=self.prompts)
  end

  task prompt(self, name: string, description: string, arguments: list<dict<string, any>>, handler: any): McpServer
    let p = McpPrompt(name=name, description=description, arguments=arguments, handler=handler)
    return McpServer(name=self.name, version=self.version, tools=self.tools, resources=self.resources, prompts=self.prompts.set(name, p))
  end

  task handle_jsonrpc(self, raw_json: string): string
    let parsed = raw_json.json()
    let err = parsed.get("err")
    if err != nil then
      return rpc_err(nil, -32700, "Parse error: " + str(err))
    end
    let req = parsed.get("ok")
    if type_of(req) != "dict" then
      return rpc_err(nil, -32600, "Invalid Request: expected JSON-RPC object")
    end
    let id = req.get("id")
    let method = req.get("method")
    let params = req.get("params")
    if method == nil then
      return rpc_err(id, -32600, "Invalid Request: missing method")
    end

    if method == "initialize" then
      let empty_obj: dict<string, any> = {}
      let caps: dict<string, any> = {"tools": empty_obj, "resources": empty_obj, "prompts": empty_obj}
      let info: dict<string, string> = {"name": self.name, "version": self.version}
      let res_obj: dict<string, any> = {}
      assign res_obj = res_obj.set("protocolVersion", "2024-11-05").set("capabilities", caps).set("serverInfo", info)
      return rpc_ok(id, res_obj)
    end
    if method == "notifications/initialized" then
      return ""
    end
    if method == "ping" then
      let empty: dict<string, any> = {}
      return rpc_ok(id, empty)
    end
    if method == "tools/list" then
      let list_out: list<any> = []
      for tname in self.tools.keys()
        let tool = self.tools.get(tname)
        if tool != nil then
          let entry: dict<string, any> = {}
          assign entry = entry.set("name", tool.name).set("description", tool.description).set("inputSchema", tool.schema)
          assign list_out = list_out.push(entry)
        end
      end
      return rpc_ok(id, {"tools": list_out})
    end
    if method == "tools/call" then
      if params == nil or type_of(params) != "dict" then
        return rpc_err(id, -32602, "Invalid params: expected params object")
      end
      let tname = params.get("name")
      let targs = params.get("arguments")
      if targs == nil then
        let empty_args: dict<string, any> = {}
        assign targs = empty_args
      end
      if type_of(targs) != "dict" then
        return rpc_err(id, -32602, "Invalid params: 'arguments' must be an object")
      end
      let tool = self.tools.get(str(tname))
      if tool == nil then
        return rpc_err(id, -32602, "Unknown tool: " + str(tname))
      end
      let val_err = validate_tool_args(tool.schema, targs)
      if val_err != "" then
        return rpc_err(id, -32602, "Invalid params: " + val_err)
      end
      let fn_handler = tool.handler
      let exec_res = try_call(fn() fn_handler(targs) end)
      if exec_res.is_err() then
        return rpc_ok(id, tool_result_payload(exec_res.unwrap_err(), true))
      end
      return rpc_ok(id, format_tool_value(exec_res.unwrap()))
    end
    if method == "resources/list" then
      let rlist: list<any> = []
      for ruri in self.resources.keys()
        let r = self.resources.get(ruri)
        if r != nil then
          let entry: dict<string, any> = {"uri": r.uri, "name": r.name, "description": r.description, "mimeType": r.mime_type}
          assign rlist = rlist.push(entry)
        end
      end
      return rpc_ok(id, {"resources": rlist})
    end
    if method == "resources/read" then
      if params == nil or type_of(params) != "dict" then
        return rpc_err(id, -32602, "Invalid params: expected params object")
      end
      let ruri = params.get("uri")
      let r = self.resources.get(str(ruri))
      if r == nil then
        return rpc_err(id, -32602, "Unknown resource: " + str(ruri))
      end
      let rfn = r.reader
      let r_exec = try_call(fn() rfn(r.uri) end)
      if r_exec.is_err() then
        return rpc_err(id, -32603, "Resource reader error: " + r_exec.unwrap_err())
      end
      let r_raw = r_exec.unwrap()
      if type_of(r_raw) == "result" then
        let r_res: result<any, any> = r_raw
        if r_res.is_err() then
          return rpc_err(id, -32603, "Resource reader error: " + str(r_res.unwrap_err()))
        end
        assign r_raw = r_res.unwrap()
      end
      let text_val = str(r_raw)
      let item: dict<string, any> = {"uri": r.uri, "mimeType": r.mime_type, "text": text_val}
      return rpc_ok(id, {"contents": [item]})
    end
    if method == "prompts/list" then
      let plist: list<any> = []
      for pname in self.prompts.keys()
        let p = self.prompts.get(pname)
        if p != nil then
          let entry: dict<string, any> = {}
          assign entry = entry.set("name", p.name).set("description", p.description).set("arguments", p.arguments)
          assign plist = plist.push(entry)
        end
      end
      return rpc_ok(id, {"prompts": plist})
    end
    if method == "prompts/get" then
      if params == nil or type_of(params) != "dict" then
        return rpc_err(id, -32602, "Invalid params: expected params object")
      end
      let pname = params.get("name")
      let p = self.prompts.get(str(pname))
      if p == nil then
        return rpc_err(id, -32602, "Unknown prompt: " + str(pname))
      end
      let pargs = params.get("arguments")
      if pargs == nil then
        let empty_pargs: dict<string, any> = {}
        assign pargs = empty_pargs
      end
      if type_of(pargs) != "dict" then
        return rpc_err(id, -32602, "Invalid params: 'arguments' must be an object")
      end
      for arg_spec in p.arguments
        let is_req = arg_spec.get("required") == true
        let aname = str(arg_spec.get("name"))
        if is_req and pargs.get(aname) == nil then
          return rpc_err(id, -32602, "Invalid params: missing required prompt argument '" + aname + "'")
        end
      end
      let pfn = p.handler
      let p_exec = try_call(fn() pfn(pargs) end)
      if p_exec.is_err() then
        return rpc_err(id, -32603, "Prompt handler error: " + p_exec.unwrap_err())
      end
      let pval = p_exec.unwrap()
      if type_of(pval) == "result" then
        let p_res: result<any, any> = pval
        if p_res.is_err() then
          return rpc_err(id, -32603, "Prompt handler error: " + str(p_res.unwrap_err()))
        end
        assign pval = p_res.unwrap()
      end
      if type_of(pval) == "string" then
        let content_obj: dict<string, any> = {"type": "text", "text": str(pval)}
        let msg: dict<string, any> = {}
        assign msg = msg.set("role", "user").set("content", content_obj)
        let res_p: dict<string, any> = {}
        assign res_p = res_p.set("description", p.description).set("messages", [msg])
        return rpc_ok(id, res_p)
      end
      if type_of(pval) == "list" then
        let res_p2: dict<string, any> = {}
        assign res_p2 = res_p2.set("description", p.description).set("messages", pval)
        return rpc_ok(id, res_p2)
      end
      return rpc_ok(id, pval)
    end
    return rpc_err(id, -32601, "Method not found: " + str(method))
  end

  -- Stdio NDJSON line-delimited JSON-RPC 2.0 transport helpers
  task handle_stdio_line(self, line: string): string
    let trimmed = line.trim()
    if trimmed == "" then
      return ""
    end
    return self.handle_jsonrpc(trimmed)
  end

  task serve_stdio_lines(self, lines: list<string>): list<string>
    let out: list<string> = []
    for line in lines
      let reply = self.handle_stdio_line(line)
      if reply != "" then
        assign out = out.push(reply)
      end
    end
    return out
  end

  task serve_stdio_channels(self, in_ch: channel<string>, out_ch: channel<string>, max_messages: int = 0, ctx: any = nil): int
    let processed = 0
    while max_messages <= 0 or processed < max_messages
      if ctx != nil and ctx.is_cancelled() then
        break
      end
      let line = if ctx != nil then in_ch.recv_ctx(ctx) else in_ch.recv() end
      if line == "" then
        break
      end
      assign processed = processed + 1
      let reply = self.handle_stdio_line(line)
      if reply != "" then
        if ctx != nil then
          out_ch.send_ctx(reply, ctx)
        else
          out_ch.send(reply)
        end
      end
    end
    return processed
  end

  task serve_stdio_stream(self, stream: tcp_stream, ctx: any = nil): int
    let processed = 0
    while true
      if ctx != nil and ctx.is_cancelled() then
        break
      end
      let raw = stream.read_line(65536, ctx)
      if raw == "" then
        break
      end
      let trimmed = raw.trim()
      if trimmed == "" then
        continue
      end
      assign processed = processed + 1
      let reply = self.handle_stdio_line(trimmed)
      if reply != "" then
        stream.write(reply + "\n", ctx)
      end
    end
    return processed
  end

  task dispatch_http(self, req: HttpRequest, stream: tcp_stream | tls_stream): any
    if req.path == "/health" and req.method == "GET" then
      return json_response(200, {"status": "ok", "server": self.name, "version": self.version})
    end
    if req.path == "/sse" and req.method == "GET" then
      sse_start(stream)
      sse_send(stream, "endpoint", "/mcp", "1")
      return nil
    end
    if req.path == "/mcp" and req.method == "POST" then
      let reply = self.handle_jsonrpc(req.body)
      if reply == "" then
        return response(204, "", "text/plain")
      end
      let hdrs: dict<string, string> = {"Content-Type": "application/json; charset=utf-8"}
      return HttpResponse(status=200, headers=hdrs, body=reply)
    end
    return json_response(404, {"error": "not found", "path": req.path})
  end

  task serve_listener(self, listener: tcp_listener | tls_listener, max_requests: int = 0, ctx: any = nil, max_body_bytes: int = 1048576): int
    let handler = fn(req: HttpRequest, stream: tcp_stream | tls_stream) self.dispatch_http(req, stream) end
    return serve_listener(listener, handler, max_requests, ctx, max_body_bytes)
  end

  task serve_http(self, addr: string, max_requests: int = 0, ctx: any = nil, max_body_bytes: int = 1048576): int
    let listener = tcp_listen(addr)
    let n = self.serve_listener(listener, max_requests, ctx, max_body_bytes)
    listener.close()
    return n
  end

  task serve_https(self, addr: string, cert_pem: string, key_pem: string, max_requests: int = 0, ctx: any = nil, max_body_bytes: int = 1048576): int
    let cfg: dict<string, any> = {}
    assign cfg = cfg.set("cert_pem", cert_pem)
    assign cfg = cfg.set("key_pem", key_pem)
    assign cfg = cfg.set("alpn", ["http/1.1"])
    let listener = tls_listen(addr, cfg)
    let n = self.serve_listener(listener, max_requests, ctx, max_body_bytes)
    listener.close()
    return n
  end
end

export task call_http(addr: string, method: string, params: dict<string, any>, id: int = 1, timeout_ms: int = 5000): result<dict<string, any>, string>
  let req_obj: dict<string, any> = {}
  assign req_obj = req_obj.set("jsonrpc", "2.0").set("id", id).set("method", method).set("params", params)
  let payload = json.stringify(req_obj)
  let resp = try_call(fn() post(addr, "/mcp", payload, "application/json", timeout_ms) end)?
  return decode_mcp_http_response(resp)
end

export task call_https(addr: string, method: string, params: dict<string, any>, server_name: string = "", tls_config: dict<string, any> = {}, id: int = 1, timeout_ms: int = 5000): result<dict<string, any>, string>
  let req_obj: dict<string, any> = {}
  assign req_obj = req_obj.set("jsonrpc", "2.0").set("id", id).set("method", method).set("params", params)
  let payload = json.stringify(req_obj)
  let resp = try_call(fn() https_post(addr, "/mcp", payload, server_name, "application/json", tls_config, timeout_ms) end)?
  return decode_mcp_http_response(resp)
end
