-- v0.103: 显式 API 构造器 —— `Type::new()` 与 Router/McpServer 方法链
-- 缺陷链：① `::` 只被词法化为 ColonColon，parser 从不消费（零使用点）
--           → `Router::new()` 整体不可达
--         ② 无 Router::new / McpServer::new 构造分派（只有实例方法）
--         ③ typeck 的 route/tool/listen 签名只声明 self，与运行时实参
--           数量不一致（"Expected 0 arguments, got 3"）
--         ④ dict 键不接受关键字 → {type: "string"} 解析失败
let router = Router::new()
let handler = fn(req) => {status: 200}
let router = router.route("GET", "/api/health", handler)

let server = McpServer::new()
let schema = {name: {type: "string"}}
let greet = fn(params) => params
let server = server.tool("greet", schema, greet)

-- v0.104.6 D79：`schema` 加 `any` 标注。
--
-- D79 给 `type_of` 补上了 `Type::String` 的精确返回类型（此前是未解算的
-- TypeVar，兼容任何东西）。于是本行这个**异质** dict 字面量第一次被真正检查：
-- `infer_dict` 取首个值的类型（`String`，来自 `type_of(router)`）并要求其余
-- 值与之 `compatible_with`，而 `schema` 是 `Dict(String, Dict(String, String))`
-- → "expected String, got Dict(...)"。
--
-- 运行期 `HashMap<String, Value>` 本就允许异质，这个 fixture 也是**有意**这么写
-- 的（`tests/e2e.rs::e2e_explicit_api_runs` 明确断言 `schema` 是 Dict）。
-- 所以真正的问题是「mora 的 dict 字面量该不该同质」这个**类型系统设计决定**，
-- 而不是这条 fixture 写错了。改 `infer_dict` 让它接受异质是宽面改动
-- （影响所有 dict 推断），已列入待用户决定清单；此处只把放进**这个异质 dict**
-- 的那一份标成 `any` —— `tool()` 调用处仍用未标注的 `schema`，保持那里的精度。
let schema_in_dict: any = schema

{router: type_of(router), server: type_of(server), schema: schema_in_dict}
