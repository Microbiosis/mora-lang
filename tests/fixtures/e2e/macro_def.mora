-- v0.83: macro 定义 + 展开 E2E 测试
-- 验证: parser 保留宏体 -> Value::Macro { body } -> 展开后进入
--  唯一的编译/执行管线（ParserV3::compile -> mir::control::lower_program
--  -> ControlProgram -> runtime::vm::execute_program）
macro double(x)
  x + x
end
macro triple(a, b)
  a + b + a
end
let d = double(21i)
let t = triple(10i, 2i)
print("double(21)=" + str(d))
print("triple(10,2)=" + str(t))
d