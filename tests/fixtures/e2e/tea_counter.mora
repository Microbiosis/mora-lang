model Counter
  count: int
  step: int
end

msg CounterMsg = Increment, Decrement, SetStep(int)

app Counter
  model: Counter
  msg: CounterMsg
  init: {count: 0, step: 1}
  update: fn(m: Counter, msg: CounterMsg) => (m, Cmd::None)
  view: fn(m: Counter) => m.count
end

let app_inst = tea.init({count: 0, step: 1})
tea.dispatch(app_inst, {tag: "Increment"})
tea.dispatch(app_inst, {tag: "Increment"})
tea.run(app_inst, 5)
tea.model(app_inst)